<template>
  <div class="container">
    <div class="search-box">
      <text class="title">按出处搜索</text>
      <input type="text" placeholder="输入出处关键词" class="search-input" value="{{searchText}}" onchange="updateSearchText" />
      <input type="button" value="🔍 搜索" class="btn btn-search" onclick="performSearch" />
    </div>

    <list class="result-list" if="showResults">
      <list-item type="item" for="(itemIndex, item) in searchResults">
        <div class="result-item">
          <text class="result-text">{{item.hitokoto}}</text>
          <text class="result-from">—— {{item.from}}</text>
          <div class="item-actions">
            <input type="button" value="{{item.favoriteIcon}}" class="btn-icon" onclick="toggleItemFavorite" data-index="{{itemIndex}}" />
          </div>
        </div>
      </list-item>
    </list>

    <text class="empty-hint" if="!showResults && searched">未找到相关句子</text>
    <text class="empty-hint" if="!showResults && !searched">请输入关键词开始搜索</text>

    <input type="button" value="⬅ 返回" class="btn btn-back" onclick="goBack" />
  </div>
</template>

<style>
  .container {
    flex-direction: column;
    padding: 20px;
    background-color: #f5f5f5;
  }

  .search-box {
    flex-direction: column;
    margin-bottom: 20px;
    padding: 15px;
    background-color: #ffffff;
    border-radius: 10px;
  }

  .title {
    font-size: 26px;
    color: #333333;
    margin-bottom: 15px;
    text-align: center;
  }

  .search-input {
    width: 100%;
    height: 50px;
    font-size: 22px;
    padding: 10px;
    border: 1px solid #dddddd;
    border-radius: 5px;
    margin-bottom: 15px;
  }

  .btn {
    width: 100%;
    height: 50px;
    font-size: 22px;
    text-align: center;
    border-radius: 5px;
    background-color: #007dfe;
    color: #ffffff;
  }

  .btn-search {
    background-color: #007dfe;
  }

  .btn-back {
    background-color: #868e96;
    margin-top: 20px;
  }

  .result-list {
    flex: 1;
    width: 100%;
  }

  .result-item {
    flex-direction: column;
    padding: 15px;
    margin-bottom: 10px;
    background-color: #ffffff;
    border-radius: 8px;
  }

  .result-text {
    font-size: 22px;
    color: #333333;
    margin-bottom: 10px;
    line-height: 1.4;
  }

  .result-from {
    font-size: 18px;
    color: #666666;
    text-align: right;
    margin-bottom: 10px;
  }

  .item-actions {
    flex-direction: row;
    justify-content: flex-end;
  }

  .btn-icon {
    width: 50px;
    height: 40px;
    font-size: 20px;
    text-align: center;
    border-radius: 5px;
    background-color: #ff6b6b;
    color: #ffffff;
  }

  .empty-hint {
    font-size: 20px;
    color: #999999;
    text-align: center;
    margin-top: 50px;
  }
</style>

<script>
  import hitokotoLogic from '../../common/scripts/logic.js';
  import router from '@system.router';

  export default {
    data: {
      searchText: '',
      searchResults: [],
      showResults: false,
      searched: false
    },
    onInit() {
      console.info('搜索页初始化');
      hitokotoLogic.init();
    },
    updateSearchText(e) {
      this.searchText = e.value;
    },
    performSearch() {
      if (!this.searchText.trim()) {
        return;
      }
      const results = hitokotoLogic.search(this.searchText);
      this.searchResults = results.map(item => ({
        hitokoto: item.hitokoto,
        from: item.from,
        uuid: item.uuid,
        favoriteIcon: hitokotoLogic.isFavorite(item.uuid) ? '❤️' : '♡'
      }));
      this.showResults = results.length > 0;
      this.searched = true;
    },
    toggleItemFavorite(e) {
      const index = e.detail.dataIndex;
      const item = this.searchResults[index];
      if (item) {
        const isFav = hitokotoLogic.isFavorite(item.uuid);
        if (isFav) {
          hitokotoLogic.removeFavorite(item.uuid);
          item.favoriteIcon = '♡';
        } else {
          hitokotoLogic.addFavorite(item.uuid);
          item.favoriteIcon = '❤️';
        }
        this.$set('searchResults', index, item);
      }
    },
    goBack() {
      router.back();
    }
  };
</script>
