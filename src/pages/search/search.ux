<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <!-- 注意：根节点不要使用 class="page"，
       InputMethod 组件内部的 .page 是 position:absolute，样式会互相污染。 -->
  <div class="s-page">
    <!-- 顶部：返回 + 命中条数 -->
    <div class="s-topbar">
      <div class="s-back" onclick="goBack">
        <text class="s-back-text">返回</text>
      </div>
      <text class="s-pageinfo" if="{{hasResults}}">{{pageCurrent}} / {{pageTotal}}</text>
    </div>

    <!-- 输入框（点击唤起键盘） -->
    <div class="s-inputbox" onclick="showKeyboard">
      <text class="s-inputtext" if="{{hasInput}}">{{searchText}}</text>
      <text class="s-ph" if="{{showPlaceholder}}">点这里输入出处</text>
    </div>

    <!-- 操作按钮 -->
    <div class="s-row">
      <div class="s-btn s-btn-primary" onclick="doSearch">
        <text class="s-btn-text">搜索</text>
      </div>
      <div class="s-btn s-btn-secondary" onclick="clearInput">
        <text class="s-btn-text">清空</text>
      </div>
    </div>

    <!-- 结果（键盘弹出时自动隐藏，避免被遮挡）
         与首页同理：不用 scroll、不用动态字号绑定 -->
    <div class="s-result" if="{{showResult}}">
      <div class="s-nav">
        <div class="s-btn s-navbtn" onclick="prevPage">
          <text class="s-btn-text">上一句</text>
        </div>
        <div class="s-btn s-navbtn" onclick="nextPage">
          <text class="s-btn-text">下一句</text>
        </div>
      </div>
      <div class="s-card">
        <div class="s-text-area">
          <text class="s-cardtext">{{pageText}}</text>
        </div>
        <text class="s-cardfrom" if="{{showFrom}}">{{pageFrom}}</text>
      </div>
    </div>

    <text class="s-hint" if="{{showHint}}">{{extraText}}</text>

    <input-method
      hide="{{keyboardHidden}}"
      keyboardtype="QWERTY"
      screentype="{{screenType}}"
      maxlength="8"
      oncomplete="onInputComplete"
      ondelete="onInputDelete"
    ></input-method>
  </div>
</template>

<style>
  .s-page {
    width: 100%;
    height: 100%;
    flex-direction: column;
    padding: 10px 14px;
    background-color: #000000;
  }

  .s-topbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 38px;
    margin-bottom: 6px;
  }

  .s-back {
    width: 74px;
    height: 34px;
    justify-content: center;
    align-items: center;
    border-radius: 8px;
    background-color: #444444;
  }

  .s-back-text {
    font-size: 20px;
    color: #ffffff;
    text-align: center;
  }

  .s-pageinfo {
    font-size: 20px;
    color: #aaaaaa;
  }

  .s-inputbox {
    width: 100%;
    height: 46px;
    justify-content: center;
    align-items: center;
    border: 1px solid #444444;
    border-radius: 8px;
    background-color: #2a2a2a;
    margin-bottom: 6px;
  }

  .s-inputtext {
    font-size: 24px;
    color: #ffffff;
    text-align: center;
    width: 100%;
    lines: 1;
    text-overflow: ellipsis;
  }

  .s-ph {
    font-size: 22px;
    color: #777777;
    text-align: center;
    width: 100%;
  }

  .s-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 46px;
    margin-bottom: 6px;
  }

  .s-btn {
    justify-content: center;
    align-items: center;
    border-radius: 10px;
  }

  .s-btn-primary {
    width: 48%;
    height: 46px;
    background-color: #0066ff;
  }

  .s-btn-secondary {
    width: 48%;
    height: 46px;
    background-color: #333333;
  }

  .s-btn-text {
    font-size: 22px;
    color: #ffffff;
    text-align: center;
  }

  .s-result {
    flex-direction: column;
    flex: 1;
    width: 100%;
  }

  .s-nav {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 42px;
    margin-bottom: 6px;
  }

  .s-navbtn {
    width: 48%;
    height: 42px;
    background-color: #555555;
  }

  /* 卡片自己负责居中（同首页） */
  .s-card {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    flex: 1;
    width: 100%;
    padding: 10px;
    background-color: #1a1a1a;
    border-radius: 10px;
  }

  /* 正文区：占满卡片剩余高度，两个方向都居中 */
  .s-text-area {
    flex: 1;
    width: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  /* 字号写死（不动态绑定） */
  .s-cardtext {
    font-size: 24px;
    color: #ffffff;
    text-align: center;
    width: 100%;
    lines: 12;
    text-overflow: ellipsis;
  }

  /* 出处：不定高、可折行 */
  .s-cardfrom {
    font-size: 20px;
    color: #999999;
    text-align: right;
    width: 100%;
    lines: 4;
    text-overflow: ellipsis;
    margin-top: 6px;
  }

  .s-hint {
    font-size: 20px;
    color: #777777;
    text-align: center;
    width: 100%;
    margin-top: 16px;
  }
</style>

<script>
  import logic from '../../common/scripts/logic.js';
  import router from '@system.router';
  import device from '@system.device';

  export default {
    data: {
      searchText: '',
      // 命中的结果 {idx, t, f}
      results: [],
      hasResults: false,
      hasInput: false,
      extraText: '输入出处关键词搜索',
      showHint: true,
      // 分页
      pageCurrent: 0,
      pageTotal: 0,
      pageText: '',
      pageFrom: '',
      showFrom: false,
      // 显隐开关，集中计算，避免模板里写复杂表达式
      showResult: false,
      showPlaceholder: true,
      keyboardHidden: true,
      // 键盘布局：rect / pill-shaped / circle
      screenType: 'rect'
    },

    onInit() {
      console.info('一言：搜索页 onInit');
      // 先用应用级结果（同步可得），拿不到就保持 rect —— 绝不能默认 circle，
      // 否则方屏/药丸屏会走到 480x321 的圆屏键盘布局上。
      let shape = '';
      try {
        const app = this.$app;
        shape = (app && app.$def && app.$def.screenShape) || '';
      } catch (e) {
        shape = '';
      }
      this.applyShape(shape);
      // 兜底：自己再问一次设备（异步），修正应用级探测的竞态
      this.detectShape();
      this.refresh();
    },

    onShow() {
      this.detectShape();
    },

    detectShape() {
      try {
        device.getInfo({
          success: (info) => {
            if (info && info.screenShape) {
              this.applyShape(info.screenShape);
            }
          },
          fail: () => {}
        });
      } catch (e) {
        console.error('一言：搜索页获取屏幕信息异常 ' + e);
      }
    },

    applyShape(shape) {
      if (shape === 'circle' || shape === 'pill-shaped' || shape === 'rect') {
        if (this.screenType !== shape) {
          this.screenType = shape;
          console.info('一言：搜索页 screentype=' + shape);
        }
      }
    },

    /** 统一刷新显隐状态。 */
    refresh() {
      this.hasInput = this.searchText !== '';
      this.showPlaceholder = !this.hasInput;
      this.showResult = this.hasResults && this.keyboardHidden;
      this.showHint = !this.hasResults && this.extraText !== '';
    },

    onInputComplete(e) {
      const content = (e && e.detail && e.detail.content) || '';
      this.searchText = (this.searchText || '') + content;
      this.refresh();
    },

    onInputDelete() {
      if (this.searchText && this.searchText.length > 0) {
        this.searchText = this.searchText.substring(0, this.searchText.length - 1);
      }
      this.refresh();
    },

    showKeyboard() {
      this.keyboardHidden = false;
      this.refresh();
    },

    doSearch() {
      const k = (this.searchText || '').trim();
      this.keyboardHidden = true;

      if (!k) {
        this.hasResults = false;
        this.results = [];
        this.extraText = '请先输入关键词';
        this.refresh();
        return;
      }

      let found = [];
      try {
        found = logic.search(k) || [];
      } catch (e) {
        const msg = (e && e.message) ? e.message : String(e);
        console.error('一言：搜索失败 ' + msg);
        this.hasResults = false;
        this.results = [];
        this.extraText = '搜索出错：' + msg;
        this.refresh();
        return;
      }

      if (!found.length) {
        this.hasResults = false;
        this.results = [];
        this.extraText = '没有找到出处包含「' + k + '」的句子';
        this.refresh();
        return;
      }

      this.results = found;
      this.hasResults = true;
      this.extraText = '';
      this.pageTotal = found.length;
      console.info('一言：搜索「' + k + '」命中 ' + found.length + ' 条');
      this.showPage(1);
    },

    showPage(n) {
      if (n < 1 || n > this.results.length) {
        return;
      }
      const it = this.results[n - 1];
      this.pageCurrent = n;
      this.pageText = it.t;
      this.pageFrom = it.f ? '—— ' + it.f : '';
      this.showFrom = !!it.f;
      this.refresh();
    },

    prevPage() {
      if (this.pageCurrent > 1) {
        this.showPage(this.pageCurrent - 1);
      }
    },

    nextPage() {
      if (this.pageCurrent < this.results.length) {
        this.showPage(this.pageCurrent + 1);
      }
    },

    clearInput() {
      this.searchText = '';
      this.results = [];
      this.hasResults = false;
      this.pageCurrent = 0;
      this.pageTotal = 0;
      this.pageText = '';
      this.pageFrom = '';
      this.showFrom = false;
      this.extraText = '输入出处关键词搜索';
      this.keyboardHidden = true;
      this.refresh();
    },

    goBack() {
      this.keyboardHidden = true;
      router.back();
    },

    onBackPress() {
      // 键盘开着就先收键盘，再按一次才返回，避免误退出
      if (this.keyboardHidden) {
        router.back();
      } else {
        this.keyboardHidden = true;
        this.refresh();
      }
      return true;
    }
  };
</script>
