<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="container">
    <!-- ===== 顶部栏：返回 + 分页信息 ===== -->
    <div class="topbar">
      <input type="button" value="← 返回" class="btn-top-back" onclick="goBack" />
      <text class="page-info" if="hasResults">{{pageCurrent}} / {{pageTotal}}</text>
    </div>

    <!-- ===== 输入区域 ===== -->
    <div class="input-area">
      <div class="display-box" onclick="showKeyboard">
        <text class="display-text" if="searchText !== ''">{{searchText}}</text>
        <text class="display-placeholder" if="searchText === ''">输入出处关键词</text>
      </div>
      <div class="button-row">
        <input type="button" value="搜索" class="btn-primary" onclick="doSearch" />
        <input type="button" value="清空" class="btn-secondary" onclick="clearInput" />
      </div>
    </div>

    <!-- ===== 结果展示区（分页：每次只显示一条） ===== -->
    <div class="result-area" if="hasResults">
      <div class="nav-row">
        <input type="button" value="上一句" class="btn-nav" onclick="prevPage" />
        <input type="button" value="下一句" class="btn-nav" onclick="nextPage" />
      </div>
      <div class="result-card">
        <text class="result-text">{{pageItem.t}}</text>
        <text class="result-from">{{pageItem.f}}</text>
      </div>
    </div>

    <text class="empty-hint" if="!hasResults && extraText !== ''">{{extraText}}</text>

    <!-- ===== 键盘组件 ===== -->
    <input-method
      hide="{{keyboardHidden}}"
      keyboardtype="QWERTY"
      screentype="rect"
      maxlength="8"
      oncomplete="onInputComplete"
      ondelete="onInputDelete"
    ></input-method>
  </div>
</template>

<style>
  .container {
    flex-direction: column;
    padding: 20px 28px;
    background-color: #000000;
  }

  /* 顶部栏 */
  .topbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 8px;
  }

  .btn-top-back {
    width: 100px;
    height: 48px;
    font-size: 24px;
    text-align: center;
    border-radius: 8px;
    background-color: #444444;
    color: #ffffff;
  }

  .page-info {
    font-size: 24px;
    color: #aaaaaa;
  }

  /* 输入区域 */
  .input-area {
    flex-direction: column;
    width: 100%;
    margin-bottom: 8px;
  }

  .display-box {
    width: 100%;
    min-height: 50px;
    padding: 8px 14px;
    margin-bottom: 8px;
    border: 1px solid #444444;
    border-radius: 8px;
    background-color: #2a2a2a;
    justify-content: center;
  }

  .display-text {
    font-size: 26px;
    color: #ffffff;
  }

  .display-placeholder {
    font-size: 24px;
    color: #666666;
  }

  .button-row {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
  }

  .btn-primary {
    width: 48%;
    height: 54px;
    font-size: 26px;
    text-align: center;
    border-radius: 8px;
    background-color: #0066ff;
    color: #ffffff;
  }

  .btn-secondary {
    width: 48%;
    height: 54px;
    font-size: 26px;
    text-align: center;
    border-radius: 8px;
    background-color: #333333;
    color: #ffffff;
  }

  /* 结果区域 */
  .result-area {
    flex-direction: column;
    width: 100%;
    margin-bottom: 8px;
  }

  .nav-row {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 6px;
  }

  .btn-nav {
    width: 48%;
    height: 48px;
    font-size: 22px;
    text-align: center;
    border-radius: 8px;
    background-color: #555555;
    color: #ffffff;
  }

  .result-card {
    flex-direction: column;
    padding: 16px;
    background-color: #1a1a1a;
    border-radius: 10px;
    width: 100%;
  }

  .result-text {
    font-size: 30px;
    color: #ffffff;
    width: 100%;
  }

  .result-from {
    font-size: 24px;
    color: #999999;
    text-align: right;
    width: 100%;
    margin-top: 8px;
  }

  .empty-hint {
    font-size: 22px;
    color: #555555;
    text-align: center;
    margin-top: 30px;
    width: 100%;
  }
</style>

<script>
  import logic from '../../common/scripts/logic.js';
  import { ps } from '../../common/scripts/data.js';
  import router from '@system.router';

  // 每页显示的条数
  const PAGE_SIZE = 1;

  export default {
    data: {
      searchText: '',
      // 全部搜索结果（原始数据）
      allResults: [],
      // 当前可见的结果
      results: [],
      hasResults: false,
      extraText: '输入出处关键词搜索',
      // 页面状态
      pageCurrent: 0,
      pageTotal: 0,
      pageItem: { t: '', f: '' },
      // 键盘
      keyboardHidden: false,
      searched: false
    },
    onInit() {
      console.info('搜索页初始化');
    },
    onInputComplete(e) {
      const content = e.detail && e.detail.content || '';
      this.searchText = (this.searchText || '') + content;
    },
    onInputDelete() {
      if (this.searchText && this.searchText.length > 0) {
        this.searchText = this.searchText.substring(0, this.searchText.length - 1);
      }
    },
    showKeyboard() {
      this.keyboardHidden = false;
    },
    doSearch() {
      const k = (this.searchText || '').trim();
      if (!k) return;
      // 隐藏键盘
      this.keyboardHidden = true;
      const all = logic.search(k);
      if (!all.length) {
        this.hasResults = false;
        this.extraText = '未找到';
        return;
      }
      // 解析所有结果
      const mapped = [];
      for (let i = 0; i < all.length; i++) {
        const parsed = ps(all[i].raw);
        mapped.push({
          t: parsed.t,
          f: parsed.f ? '—— ' + parsed.f : ''
        });
      }
      this.allResults = mapped;
      this.hasResults = true;
      this.extraText = '';
      // 分页
      this.pageCurrent = 1;
      this.pageTotal = mapped.length;
      this.showPage(1);
    },
    showPage(n) {
      if (n < 1 || n > this.allResults.length) return;
      this.pageCurrent = n;
      this.pageItem = this.allResults[n - 1];
    },
    prevPage() {
      if (this.pageCurrent > 1) {
        this.showPage(this.pageCurrent - 1);
      }
    },
    nextPage() {
      if (this.pageCurrent < this.allResults.length) {
        this.showPage(this.pageCurrent + 1);
      }
    },
    clearInput() {
      this.searchText = '';
      this.allResults = [];
      this.hasResults = false;
      this.extraText = '输入出处关键词搜索';
      this.keyboardHidden = false;
    },
    goBack() {
      router.back();
    },
    onBackPress() {
      router.back();
      return true;
    }
  };
</script>
