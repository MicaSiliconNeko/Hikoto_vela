<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <!-- 注意：根节点不要使用 class="page"，
       InputMethod 组件内部的 .page 是 position:absolute，样式会互相污染。 -->
  <div class="s-page">
    <!-- 顶部：返回 + 命中条数 -->
    <div class="s-topbar">
      <div class="s-back" onclick="goBack">
        <text class="s-back-text">返回</text>
      </div>
      <text class="s-pageinfo" if="{{hasResults}}">{{pageCurrent}} / {{pageTotal}}</text>
    </div>

    <!-- 输入框（点击唤起键盘） -->
    <div class="s-inputbox" onclick="showKeyboard">
      <text class="s-inputtext" if="{{hasInput}}">{{searchText}}</text>
      <text class="s-ph" if="{{showPlaceholder}}">点这里输入出处</text>
    </div>

    <!-- 操作按钮 -->
    <div class="s-row">
      <div class="s-btn s-btn-primary" onclick="doSearch">
        <text class="s-btn-text">搜索</text>
      </div>
      <div class="s-btn s-btn-secondary" onclick="clearInput">
        <text class="s-btn-text">清空</text>
      </div>
    </div>

    <!-- 结果（键盘弹出时自动隐藏，避免被遮挡）
         与首页同理：不用 scroll、不用动态 style，长句靠多档静态字号 + if 挑选 -->
    <div class="s-result" if="{{showResult}}">
      <div class="s-nav">
        <div class="s-btn s-navbtn" onclick="prevPage">
          <text class="s-btn-text">上一句</text>
        </div>
        <div class="s-btn s-navbtn" onclick="nextPage">
          <text class="s-btn-text">下一句</text>
        </div>
      </div>
      <div class="s-card">
        <div class="s-text-area">
          <text class="s-cardtext s-sz24" if="{{textSize == 24}}">{{pageText}}</text>
          <text class="s-cardtext s-sz21" if="{{textSize == 21}}">{{pageText}}</text>
          <text class="s-cardtext s-sz18" if="{{textSize == 18}}">{{pageText}}</text>
          <text class="s-cardtext s-sz15" if="{{textSize == 15}}">{{pageText}}</text>
          <text class="s-cardtext s-sz13" if="{{textSize == 13}}">{{pageText}}</text>
          <text class="s-cardtext s-sz12" if="{{textSize == 12}}">{{pageText}}</text>
        </div>
        <text class="s-cardfrom" if="{{showFrom}}">{{pageFrom}}</text>
      </div>
    </div>

    <text class="s-hint" if="{{showHint}}">{{extraText}}</text>

    <input-method
      hide="{{keyboardHidden}}"
      keyboardtype="QWERTY"
      screentype="{{screenType}}"
      maxlength="8"
      oncomplete="onInputComplete"
      ondelete="onInputDelete"
    ></input-method>
  </div>
</template>

<style>
  .s-page {
    width: 100%;
    height: 100%;
    flex-direction: column;
    padding: 10px 14px;
    background-color: #000000;
  }

  .s-topbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 38px;
    margin-bottom: 6px;
  }

  .s-back {
    width: 74px;
    height: 34px;
    justify-content: center;
    align-items: center;
    border-radius: 8px;
    background-color: #444444;
  }

  .s-back-text {
    font-size: 20px;
    color: #ffffff;
    text-align: center;
  }

  .s-pageinfo {
    font-size: 20px;
    color: #aaaaaa;
  }

  .s-inputbox {
    width: 100%;
    height: 46px;
    justify-content: center;
    align-items: center;
    border: 1px solid #444444;
    border-radius: 8px;
    background-color: #2a2a2a;
    margin-bottom: 6px;
  }

  .s-inputtext {
    font-size: 24px;
    color: #ffffff;
    text-align: center;
    width: 100%;
    lines: 1;
    text-overflow: ellipsis;
  }

  .s-ph {
    font-size: 22px;
    color: #777777;
    text-align: center;
    width: 100%;
  }

  .s-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 46px;
    margin-bottom: 6px;
  }

  .s-btn {
    justify-content: center;
    align-items: center;
    border-radius: 10px;
  }

  .s-btn-primary {
    width: 48%;
    height: 46px;
    background-color: #0066ff;
  }

  .s-btn-secondary {
    width: 48%;
    height: 46px;
    background-color: #333333;
  }

  .s-btn-text {
    font-size: 22px;
    color: #ffffff;
    text-align: center;
  }

  .s-result {
    flex-direction: column;
    flex: 1;
    width: 100%;
  }

  .s-nav {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 42px;
    margin-bottom: 6px;
  }

  .s-navbtn {
    width: 48%;
    height: 42px;
    background-color: #555555;
  }

  /* 卡片自己负责居中（同首页） */
  .s-card {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    flex: 1;
    width: 100%;
    padding: 10px;
    background-color: #1a1a1a;
    border-radius: 10px;
  }

  /* 正文区：占满卡片剩余高度，两个方向都居中 */
  .s-text-area {
    flex: 1;
    width: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  /* 正文公共样式（字号由下面的档位类给）。类名加 s- 前缀，避开键盘组件的类名 */
  .s-cardtext {
    color: #ffffff;
    text-align: center;
    width: 100%;
    lines: 20;
    text-overflow: ellipsis;
  }

  .s-sz24 { font-size: 24px; }
  .s-sz21 { font-size: 21px; }
  .s-sz18 { font-size: 18px; }
  .s-sz15 { font-size: 15px; }
  .s-sz13 { font-size: 13px; }
  .s-sz12 { font-size: 12px; }

  /* 出处：不定高、可折行 */
  .s-cardfrom {
    font-size: 20px;
    color: #999999;
    text-align: right;
    width: 100%;
    lines: 4;
    text-overflow: ellipsis;
    margin-top: 6px;
  }

  .s-hint {
    font-size: 20px;
    color: #777777;
    text-align: center;
    width: 100%;
    margin-top: 16px;
  }
</style>

<script>
  import logic from '../../common/scripts/logic.js';
  import router from '@system.router';
  import device from '@system.device';

  // 水平方向被吃掉的宽度：页面左右内边距 14*2 + 卡片内边距 10*2
  const TEXT_INSET = 48;
  // 竖向固定占用（改上面 CSS 的尺寸时，这几个数要跟着改）
  const PAGE_PAD_V = 20;      // 页面上下 padding 10*2
  const TOPBAR_H = 44;        // s-topbar 38 + margin 6
  const INPUT_H = 52;         // s-inputbox 46 + margin 6
  const ROW_H = 52;           // s-row 46 + margin 6
  const NAV_H = 48;           // s-nav 42 + margin 6
  const CARD_PAD_V = 20;      // s-card padding 10*2

  // 出处行（CSS 里 lines:4，20px）
  const FROM_FONT = 20;
  const FROM_LINE_H = 26;
  const FROM_MARGIN = 6;
  const MAX_FROM_LINES = 4;

  // 字号档位（与模板 if 条件、上面 .s-szN 类一一对应）
  const SIZES = [24, 21, 18, 15, 13, 12];
  const LINE_RATIO = 1.7;
  const NARROW = 0.55;

  const MIN_AREA_H = 50;
  const FALLBACK_SCREEN_H = 480;
  const FALLBACK_SCREEN_W = 336;

  export default {
    data: {
      searchText: '',
      // 命中的结果 {idx, t, f}
      results: [],
      hasResults: false,
      hasInput: false,
      extraText: '输入出处关键词搜索',
      showHint: true,
      // 分页
      pageCurrent: 0,
      pageTotal: 0,
      pageText: '',
      pageFrom: '',
      showFrom: false,
      // 显隐开关，集中计算，避免模板里写复杂表达式
      showResult: false,
      showPlaceholder: true,
      keyboardHidden: true,
      // 键盘布局：rect / pill-shaped / circle
      screenType: 'rect',
      screenWidth: 0,
      screenHeight: 0,
      textSize: 24
    },

    onInit() {
      console.info('一言：搜索页 onInit');
      // 先用应用级结果（同步可得），拿不到就保持 rect —— 绝不能默认 circle，
      // 否则方屏/药丸屏会走到 480x321 的圆屏键盘布局上。
      let shape = '';
      try {
        const app = this.$app;
        shape = (app && app.$def && app.$def.screenShape) || '';
        this.screenWidth = (app && app.$def && app.$def.screenWidth) || 0;
        this.screenHeight = (app && app.$def && app.$def.screenHeight) || 0;
      } catch (e) {
        shape = '';
      }
      this.applyShape(shape);
      // 兜底：自己再问一次设备（异步），修正应用级探测的竞态
      this.detectShape();
      this.refresh();
    },

    onShow() {
      this.detectShape();
    },

    detectShape() {
      try {
        device.getInfo({
          success: (info) => {
            if (!info) {
              return;
            }
            if (info.screenShape) {
              this.applyShape(info.screenShape);
            }
            if (info.screenWidth) {
              this.screenWidth = info.screenWidth;
            }
            if (info.screenHeight) {
              this.screenHeight = info.screenHeight;
            }
            this.applySize();
          },
          fail: () => {}
        });
      } catch (e) {
        console.error('一言：搜索页获取屏幕信息异常 ' + e);
      }
    },

    applyShape(shape) {
      if (shape === 'circle' || shape === 'pill-shaped' || shape === 'rect') {
        if (this.screenType !== shape) {
          this.screenType = shape;
          console.info('一言：搜索页 screentype=' + shape);
        }
      }
    },

    /** 字数换算成「汉字宽度」单位数（半角按 0.55 计） */
    unitsOf(s) {
      let n = 0;
      for (let i = 0; i < s.length; i++) {
        n += s.charCodeAt(i) >= 0x2e80 ? 1 : NARROW;
      }
      return n;
    },

    /** 出处折行后占的高度 */
    fromHeight() {
      const s = this.pageFrom || '';
      if (!s) {
        return 0;
      }
      const w = (this.screenWidth || FALLBACK_SCREEN_W) - TEXT_INSET;
      if (w <= 0) {
        return FROM_LINE_H + FROM_MARGIN;
      }
      let lines = Math.ceil(this.unitsOf(s) * FROM_FONT / w);
      if (lines < 1) {
        lines = 1;
      }
      if (lines > MAX_FROM_LINES) {
        lines = MAX_FROM_LINES;
      }
      return lines * FROM_LINE_H + FROM_MARGIN;
    },

    /** 结果正文可用高度（只用来挑字号） */
    areaHeight() {
      const sh = this.screenHeight || FALLBACK_SCREEN_H;
      const cardH = sh - PAGE_PAD_V - TOPBAR_H - INPUT_H - ROW_H - NAV_H;
      const srcH = this.showFrom ? this.fromHeight() : 0;
      const h = cardH - CARD_PAD_V - srcH;
      return h > MIN_AREA_H ? h : MIN_AREA_H;
    },

    /** 从档位里挑一个「整句能完整放下」的最大字号，推导见 index.ux。 */
    pickSize(text) {
      if (!text) {
        return SIZES[0];
      }
      const units = this.unitsOf(text);
      const w = (this.screenWidth || FALLBACK_SCREEN_W) - TEXT_INSET;
      const h = this.areaHeight();
      if (units <= 0 || w <= 0 || h <= 0) {
        return SIZES[0];
      }
      for (let i = 0; i < SIZES.length; i++) {
        const f = SIZES[i];
        const lines = Math.ceil(units * f / w);
        if (lines * f * LINE_RATIO <= h) {
          return f;
        }
      }
      return SIZES[SIZES.length - 1];
    },

    applySize() {
      this.textSize = this.pickSize(this.pageText);
    },

    /** 统一刷新显隐状态。 */
    refresh() {
      this.hasInput = this.searchText !== '';
      this.showPlaceholder = !this.hasInput;
      this.showResult = this.hasResults && this.keyboardHidden;
      this.showHint = !this.hasResults && this.extraText !== '';
    },

    onInputComplete(e) {
      const content = (e && e.detail && e.detail.content) || '';
      this.searchText = (this.searchText || '') + content;
      this.refresh();
    },

    onInputDelete() {
      if (this.searchText && this.searchText.length > 0) {
        this.searchText = this.searchText.substring(0, this.searchText.length - 1);
      }
      this.refresh();
    },

    showKeyboard() {
      this.keyboardHidden = false;
      this.refresh();
    },

    doSearch() {
      const k = (this.searchText || '').trim();
      this.keyboardHidden = true;

      if (!k) {
        this.hasResults = false;
        this.results = [];
        this.extraText = '请先输入关键词';
        this.refresh();
        return;
      }

      let found = [];
      try {
        found = logic.search(k) || [];
      } catch (e) {
        const msg = (e && e.message) ? e.message : String(e);
        console.error('一言：搜索失败 ' + msg);
        this.hasResults = false;
        this.results = [];
        this.extraText = '搜索出错：' + msg;
        this.refresh();
        return;
      }

      if (!found.length) {
        this.hasResults = false;
        this.results = [];
        this.extraText = '没有找到出处包含「' + k + '」的句子';
        this.refresh();
        return;
      }

      this.results = found;
      this.hasResults = true;
      this.extraText = '';
      this.pageTotal = found.length;
      console.info('一言：搜索「' + k + '」命中 ' + found.length + ' 条');
      this.showPage(1);
    },

    showPage(n) {
      if (n < 1 || n > this.results.length) {
        return;
      }
      const it = this.results[n - 1];
      this.pageCurrent = n;
      this.pageText = it.t;
      this.pageFrom = it.f ? '—— ' + it.f : '';
      this.showFrom = !!it.f;
      this.applySize();
      this.refresh();
    },

    prevPage() {
      if (this.pageCurrent > 1) {
        this.showPage(this.pageCurrent - 1);
      }
    },

    nextPage() {
      if (this.pageCurrent < this.results.length) {
        this.showPage(this.pageCurrent + 1);
      }
    },

    clearInput() {
      this.searchText = '';
      this.results = [];
      this.hasResults = false;
      this.pageCurrent = 0;
      this.pageTotal = 0;
      this.pageText = '';
      this.pageFrom = '';
      this.showFrom = false;
      this.extraText = '输入出处关键词搜索';
      this.keyboardHidden = true;
      this.refresh();
    },

    goBack() {
      this.keyboardHidden = true;
      router.back();
    },

    onBackPress() {
      // 键盘开着就先收键盘，再按一次才返回，避免误退出
      if (this.keyboardHidden) {
        router.back();
      } else {
        this.keyboardHidden = true;
        this.refresh();
      }
      return true;
    }
  };
</script>
