<script>
  import router from '@system.router';
  // 只引入计数用小文件。千万不要在这里 import logic.js ——
  // 那会把整份句子库再打包进 about 页，白白多出一个 1MB 的包。
  import meta from '../../common/scripts/meta.js';

  export default {
    data: {
      count: 0
    },

    onInit() {
      this.count = meta.COUNT || 0;
    },

    goBack() {
      router.back();
    },

    onBackPress() {
      router.back();
      return true;
    }
