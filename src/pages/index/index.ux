<template>
  <div class="container">
    <div class="content-box">
      <text class="hitokoto-text">{{currentText}}</text>
      <text class="from-text">—— {{currentFrom}}</text>
    </div>

    <div class="button-row">
      <input type="button" value="刷新" class="btn btn-primary" onclick="refreshSentence" />
      <input type="button" value="{{favoriteBtnText}}" class="btn btn-primary" onclick="toggleFavorite" />
    </div>

    <div class="button-row">
      <input type="button" value="搜索" class="btn btn-primary" onclick="goToSearch" />
      <input type="button" value="收藏列表" class="btn btn-primary" onclick="showFavorites" />
    </div>

    <text class="hint-text">{{hint}}</text>
  </div>
</template>

<style>
  .container {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 20px;
    background-color: #000000;
  }

  .content-box {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    margin-bottom: 40px;
    padding: 20px;
    background-color: #1a1a1a;
    border-radius: 10px;
    width: 90%;
  }

  .hitokoto-text {
    font-size: 28px;
    color: #ffffff;
    text-align: center;
    margin-bottom: 20px;
    line-height: 1.5;
  }

  .from-text {
    font-size: 20px;
    color: #cccccc;
    text-align: right;
    width: 100%;
  }

  .button-row {
    flex-direction: row;
    justify-content: space-around;
    width: 100%;
    margin-bottom: 15px;
  }

  .btn {
    width: 45%;
    height: 60px;
    font-size: 24px;
    text-align: center;
    border-radius: 8px;
  }

  .btn-primary {
    background-color: #0066FF;
    color: #ffffff;
  }

  .hint-text {
    font-size: 18px;
    color: #999999;
    margin-top: 20px;
    text-align: center;
  }
</style>

<script>
  import hitokotoLogic from '../../common/scripts/logic.js';
  import router from '@system.router';

  export default {
    data: {
      currentText: '点击刷新获取一言',
      currentFrom: '',
      currentUuid: '',
      isFavorited: false,
      favoriteBtnText: '收藏',
      hint: ''
    },
    onInit() {
      console.info('主页初始化');
      hitokotoLogic.init();
      this.refreshSentence();
    },
    refreshSentence() {
      const sentence = hitokotoLogic.getRandomSentence();
      if (sentence) {
        this.currentText = sentence.hitokoto;
        this.currentFrom = sentence.from;
        this.currentUuid = sentence.uuid;
        this.isFavorited = hitokotoLogic.isFavorite(sentence.uuid);
        this.updateFavoriteBtnText();
        this.hint = '';
      } else {
        this.hint = '加载失败，请重试';
      }
    },
    updateFavoriteBtnText() {
      this.favoriteBtnText = this.isFavorited ? '已藏' : '收藏';
    },
    toggleFavorite() {
      if (!this.currentUuid) {
        this.hint = '请先刷新获取句子';
        return;
      }
      if (this.isFavorited) {
        hitokotoLogic.removeFavorite(this.currentUuid);
        this.isFavorited = false;
        this.hint = '已取消收藏';
      } else {
        hitokotoLogic.addFavorite(this.currentUuid);
        this.isFavorited = true;
        this.hint = '已加入收藏';
      }
      this.updateFavoriteBtnText();
    },
    goToSearch() {
      router.push({
        uri: 'pages/search/index'
      });
    },
    showFavorites() {
      const favorites = hitokotoLogic.getFavoriteSentences();
      if (favorites.length === 0) {
        this.hint = '暂无收藏';
      } else {
        this.hint = '已收藏 ' + favorites.length + ' 条';
      }
    }
  };
</script>
