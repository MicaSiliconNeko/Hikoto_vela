<template>
  <div class="page">
    <!-- 顶栏：左右各一个 72×72 圆钮，标题 32px 居中（= 无源流沙 规范） -->
    <div class="topbar">
      <div class="icon-btn" onclick="goToAbout">
        <text class="icon-btn-text">关于</text>
      </div>
      <text class="title">一言</text>
      <div class="icon-btn" onclick="goToSearch">
        <text class="icon-btn-text">搜索</text>
      </div>
    </div>

    <!--
      正文卡片：不用 <scroll>（真机上内部拿不到 width:100%，文字会贴边），
      也不用「动态绑定的 style」（实测内存杀手，7000 条会 OOM）。
      长句靠「多档静态字号 + if 条件挑选」完整显示：每个档位是一个写死
      font-size 的 CSS 类，模板里按 textSize 只显示其中一个。
      这种 if 切换与出处/提示是同一套机制，7000 条下已验证稳定。
    -->
    <div class="card">
      <div class="text-area">
        <text class="hitokoto-text sz32" if="{{textSize == 32}}">{{currentText}}</text>
        <text class="hitokoto-text sz28" if="{{textSize == 28}}">{{currentText}}</text>
        <text class="hitokoto-text sz24" if="{{textSize == 24}}">{{currentText}}</text>
        <text class="hitokoto-text sz20" if="{{textSize == 20}}">{{currentText}}</text>
        <text class="hitokoto-text sz17" if="{{textSize == 17}}">{{currentText}}</text>
        <text class="hitokoto-text sz14" if="{{textSize == 14}}">{{currentText}}</text>
        <text class="hitokoto-text sz12" if="{{textSize == 12}}">{{currentText}}</text>
      </div>
      <text class="from-text" if="{{showFrom}}">{{currentFrom}}</text>
    </div>

    <!-- 主操作：#0D6EFF 强调色按钮 -->
    <div class="primary-btn" onclick="refreshSentence">
      <text class="primary-text">换一句</text>
    </div>

    <text class="hint" if="{{showHint}}">{{hint}}</text>
  </div>
</template>

<style>
  /* ---- 设计令牌（无源流沙 / 小米手环 9 Pro，画布 336×480）----
     背景 #000000 · 卡片与圆钮 #262626 · 强调 #0D6EFF
     文字：标题/正文 32 白 · 次要 28 白 60%（#999999）
     圆钮 72×72 · 卡片圆角 20 · 页面边距 6 · 屏角半径 48 */
  .page {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    padding: 6px;
    background-color: #000000;
  }

  .topbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 72px;
    margin-bottom: 6px;
  }

  .title {
    flex: 1;
    font-size: 32px;
    font-weight: bold;
    color: #ffffff;
    text-align: center;
  }

  .icon-btn {
    width: 72px;
    height: 72px;
    justify-content: center;
    align-items: center;
    border-radius: 999px;
    background-color: #262626;
  }

  .icon-btn-text {
    font-size: 24px;
    color: #ffffff;
    text-align: center;
  }

  /* 卡片自己负责居中（真机验证过的做法，不要依赖内层 width:100%） */
  .card {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    flex: 1;
    width: 100%;
    padding: 16px;
    background-color: #262626;
    border-radius: 20px;
  }

  /* 正文区：占满卡片剩余高度，两个方向都居中 */
  .text-area {
    flex: 1;
    width: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  /* 正文公共样式：颜色/居中/换行上限（字号由下面的档位类给） */
  .hitokoto-text {
    color: #ffffff;
    text-align: center;
    width: 100%;
    lines: 20;
    text-overflow: ellipsis;
  }

  /* 字号档位：只改 font-size，其余继承 .hitokoto-text
     （与模板 if 条件、JS 里的 SIZES 一一对应，改一处要同步改三处） */
  .sz32 { font-size: 32px; }
  .sz28 { font-size: 28px; }
  .sz24 { font-size: 24px; }
  .sz20 { font-size: 20px; }
  .sz17 { font-size: 17px; }
  .sz14 { font-size: 14px; }
  .sz12 { font-size: 12px; }

  /* 出处：28px 白 60% ≈ #999999 */
  .from-text {
    font-size: 28px;
    color: #999999;
    text-align: right;
    width: 100%;
    lines: 2;
    text-overflow: ellipsis;
    margin-top: 8px;
  }

  /* 主操作：#0D6EFF 强调色胶囊按钮（比卡片矮一档，把高度让给正文） */
  .primary-btn {
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 52px;
    margin-top: 6px;
    border-radius: 999px;
    background-color: #0d6eff;
  }

  .primary-text {
    font-size: 28px;
    color: #ffffff;
    text-align: center;
  }

  .hint {
    font-size: 24px;
    color: #999999;
    text-align: center;
    width: 100%;
    lines: 1;
    text-overflow: ellipsis;
    margin-top: 6px;
  }
</style>

<script>
  import logic from '../../common/scripts/logic.js';
  import router from '@system.router';
  import device from '@system.device';

  // 水平方向被吃掉的宽度：页面左右 padding 6*2 + 卡片 padding 16*2
  const TEXT_INSET = 44;
  // 竖向固定占用（改上面 CSS 的尺寸时，这几个数要跟着改）
  const PAGE_PAD_V = 12;      // 页面上下 padding 6*2
  const TOPBAR_H = 78;        // topbar 72 + margin 6
  const BTN_H = 58;           // primary-btn 52 + margin 6
  const CARD_PAD_V = 32;      // card padding 16*2
  const HINT_H = 30;          // hint 行高 + margin（仅 showHint 时占位）

  // 出处行（CSS 里 lines:2，28px）
  const FROM_FONT = 28;
  const FROM_LINE_H = 36;
  const FROM_MARGIN = 8;
  const MAX_FROM_LINES = 2;

  // 字号档位（与模板 if 条件、上面的 .szN 类一一对应）
  const SIZES = [32, 28, 24, 20, 17, 14, 12];
  const LINE_RATIO = 1.7;     // 行高/字号，往大里估，宁可多缩一档
  const NARROW = 0.55;        // 半角字符按 0.55 个汉字宽

  const MIN_AREA_H = 40;
  const FALLBACK_SCREEN_H = 480;
  const FALLBACK_SCREEN_W = 336;

  export default {
    data: {
      currentText: '加载中…',
      currentFrom: '',
      showFrom: false,
      hint: '',
      showHint: false,
      screenWidth: 0,
      screenHeight: 0,
      textSize: 32
    },

    onInit() {
      console.info('一言：主页 onInit');
      this.syncScreen();
      this.loadRandom();
    },

    onShow() {
      this.syncScreen();
    },

    /** 读屏幕尺寸：缩字号要按可用面积算，宽高都得拿到。 */
    syncScreen() {
      let w = 0;
      let h = 0;
      try {
        const app = this.$app;
        w = (app && app.$def && app.$def.screenWidth) || 0;
        h = (app && app.$def && app.$def.screenHeight) || 0;
      } catch (e) {
        w = 0;
        h = 0;
      }
      if (w) {
        this.screenWidth = w;
      }
      if (h) {
        this.screenHeight = h;
      }
      this.applySize();

      if (w && h) {
        return;
      }
      try {
        device.getInfo({
          success: (info) => {
            if (!info) {
              return;
            }
            if (info.screenWidth) {
              this.screenWidth = info.screenWidth;
            }
            if (info.screenHeight) {
              this.screenHeight = info.screenHeight;
            }
            this.applySize();
          },
          fail: () => {}
        });
      } catch (e) {
        console.error('一言：主页获取屏幕信息异常 ' + e);
      }
    },

    /** 字数换算成「汉字宽度」单位数（半角按 0.55 计） */
    unitsOf(s) {
      let n = 0;
      for (let i = 0; i < s.length; i++) {
        n += s.charCodeAt(i) >= 0x2e80 ? 1 : NARROW;
      }
      return n;
    },

    /** 出处折行后占的高度 */
    fromHeight() {
      const s = this.currentFrom || '';
      if (!s) {
        return 0;
      }
      const w = (this.screenWidth || FALLBACK_SCREEN_W) - TEXT_INSET;
      if (w <= 0) {
        return FROM_LINE_H + FROM_MARGIN;
      }
      let lines = Math.ceil(this.unitsOf(s) * FROM_FONT / w);
      if (lines < 1) {
        lines = 1;
      }
      if (lines > MAX_FROM_LINES) {
        lines = MAX_FROM_LINES;
      }
      return lines * FROM_LINE_H + FROM_MARGIN;
    },

    /** 正文可用高度（只用来挑字号，不绑到样式上） */
    areaHeight() {
      const sh = this.screenHeight || FALLBACK_SCREEN_H;
      const hint = this.showHint ? HINT_H : 0;
      const srcH = this.showFrom ? this.fromHeight() : 0;
      const h = sh - PAGE_PAD_V - TOPBAR_H - BTN_H - hint - CARD_PAD_V - srcH;
      return h > MIN_AREA_H ? h : MIN_AREA_H;
    },

    /**
     * 从档位里挑一个「整句能完整放下」的最大字号。
     * 字号 f 时每行放 W/f 个汉字单位，需要 ceil(units*f/W) 行，
     * 总高 ≈ 行数 * f * LINE_RATIO ≤ H。
     */
    pickSize(text) {
      if (!text) {
        return SIZES[0];
      }
      const units = this.unitsOf(text);
      const w = (this.screenWidth || FALLBACK_SCREEN_W) - TEXT_INSET;
      const h = this.areaHeight();
      if (units <= 0 || w <= 0 || h <= 0) {
        return SIZES[0];
      }
      for (let i = 0; i < SIZES.length; i++) {
        const f = SIZES[i];
        const lines = Math.ceil(units * f / w);
        if (lines * f * LINE_RATIO <= h) {
          return f;
        }
      }
      return SIZES[SIZES.length - 1];
    },

    applySize() {
      this.textSize = this.pickSize(this.currentText);
    },

    /** 取一条随机句子并刷新界面。全程 try/catch，避免异常导致白屏。 */
    loadRandom() {
      try {
        const total = logic.init();
        console.info('一言：可用句子 ' + total + ' 条');
        const item = logic.getRandom();
        if (item && item.t) {
          this.currentText = item.t;
          this.currentFrom = item.f ? '—— ' + item.f : '';
          this.showFrom = !!item.f;
          this.hint = '';
          this.showHint = false;
          this.applySize();
          console.info('一言：正文 ' + item.t.length + ' 字，字号 ' + this.textSize);
        } else {
          this.currentText = '暂无数据';
          this.showFrom = false;
          this.hint = '句子数据读取为空';
          this.showHint = true;
          this.applySize();
        }
      } catch (e) {
        const msg = (e && e.message) ? e.message : String(e);
        console.error('一言：加载句子失败 ' + msg);
        this.currentText = '加载失败';
        this.showFrom = false;
        this.hint = '错误：' + msg;
        this.showHint = true;
        this.applySize();
      }
    },

    refreshSentence() {
      this.loadRandom();
    },

    goToSearch() {
      router.push({ uri: 'pages/search' });
    },

    goToAbout() {
      router.push({ uri: 'pages/about' });
    },

    // 主页作为入口页，返回键不退出
    onBackPress() {
      return false;
    }
  };
</script>
