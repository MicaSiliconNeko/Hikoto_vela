<template>
  <div class="page">
    <!-- 顶部：标题 + 关于入口 -->
    <div class="topbar">
      <text class="title">一言</text>
      <div class="btn-about" onclick="goToAbout">
        <text class="btn-about-text">关于</text>
      </div>
    </div>

    <!--
      正文卡片：不使用 <scroll>（真机上 scroll 内部拿不到 width:100%，文字会贴边），
      也不使用「动态绑定的 font-size」（实测它是内存杀手，会让 7000 条 OOM）。
      字号写死在 CSS 里，超长句用 lines + 省略号收尾 —— 与长期正常的 1.0.1 一致。
    -->
    <div class="content-box">
      <div class="text-area">
        <text class="hitokoto-text">{{currentText}}</text>
      </div>
      <text class="from-text" if="{{showFrom}}">{{currentFrom}}</text>
    </div>

    <!-- 操作 -->
    <div class="button-row">
      <div class="btn btn-primary" onclick="refreshSentence">
        <text class="btn-text">换一句</text>
      </div>
      <div class="btn btn-primary" onclick="goToSearch">
        <text class="btn-text">搜索</text>
      </div>
    </div>

    <text class="hint" if="{{showHint}}">{{hint}}</text>
  </div>
</template>

<style>
  .page {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 14px 18px;
    background-color: #000000;
  }

  .topbar {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    width: 100%;
    height: 44px;
    margin-bottom: 8px;
  }

  .title {
    font-size: 28px;
    color: #ffffff;
    font-weight: bold;
    flex: 1;
    text-align: center;
  }

  .btn-about {
    width: 64px;
    height: 36px;
    justify-content: center;
    align-items: center;
    border-radius: 8px;
    background-color: #333333;
  }

  .btn-about-text {
    font-size: 20px;
    color: #cccccc;
    text-align: center;
  }

  /* 卡片自己负责居中（1.0.1 的做法，真机验证过） */
  .content-box {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    flex: 1;
    width: 100%;
    padding: 14px;
    margin-bottom: 12px;
    background-color: #1a1a1a;
    border-radius: 12px;
  }

  /* 正文区：占满卡片剩余高度，两个方向都居中 */
  .text-area {
    flex: 1;
    width: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  /* 字号写死（不动态绑定，避免额外运行时开销） */
  .hitokoto-text {
    font-size: 26px;
    color: #ffffff;
    text-align: center;
    width: 100%;
    lines: 12;
    text-overflow: ellipsis;
  }

  /* 出处：不定高、可折行 */
  .from-text {
    font-size: 20px;
    color: #999999;
    text-align: right;
    width: 100%;
    lines: 4;
    text-overflow: ellipsis;
    margin-top: 8px;
  }

  .button-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 56px;
  }

  .btn {
    justify-content: center;
    align-items: center;
    border-radius: 12px;
  }

  .btn-primary {
    width: 48%;
    height: 56px;
    background-color: #0066ff;
  }

  .btn-text {
    font-size: 26px;
    color: #ffffff;
    text-align: center;
  }

  .hint {
    font-size: 18px;
    color: #888888;
    text-align: center;
    width: 100%;
    lines: 2;
    text-overflow: ellipsis;
    margin-top: 8px;
  }
</style>

<script>
  import logic from '../../common/scripts/logic.js';
  import router from '@system.router';

  export default {
    data: {
      currentText: '加载中…',
      currentFrom: '',
      showFrom: false,
      hint: '',
      showHint: false
    },

    onInit() {
      console.info('一言：主页 onInit');
      this.loadRandom();
    },

    /** 取一条随机句子并刷新界面。全程 try/catch，避免异常导致白屏。 */
    loadRandom() {
      try {
        const total = logic.init();
        console.info('一言：可用句子 ' + total + ' 条');
        const item = logic.getRandom();
        if (item && item.t) {
          this.currentText = item.t;
          this.currentFrom = item.f ? '—— ' + item.f : '';
          this.showFrom = !!item.f;
          this.hint = '';
          this.showHint = false;
        } else {
          this.currentText = '暂无数据';
          this.showFrom = false;
          this.hint = '句子数据读取为空';
          this.showHint = true;
        }
      } catch (e) {
        const msg = (e && e.message) ? e.message : String(e);
        console.error('一言：加载句子失败 ' + msg);
        this.currentText = '加载失败';
        this.showFrom = false;
        this.hint = '错误：' + msg;
        this.showHint = true;
      }
    },

    refreshSentence() {
      this.loadRandom();
    },

    goToSearch() {
      router.push({ uri: 'pages/search' });
    },

    goToAbout() {
      router.push({ uri: 'pages/about' });
    },

    // 主页作为入口页，返回键不退出
    onBackPress() {
      return false;
    }
  };
</script>
